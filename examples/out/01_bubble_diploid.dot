digraph GD {
  rankdir=LR;
  node [style=filled];
  n0 [label="(s,s)", shape=ellipse, fillcolor="#cfe3f7"];
  n1 [label="(a,a)", shape=ellipse, fillcolor="#cfe3f7"];
  n2 [label="(t,t)", shape=ellipse, fillcolor="#cfe3f7"];
  n3 [label="(b,b)", shape=ellipse, fillcolor="#cfe3f7"];
  n4 [label="(b, a)", shape=box, fillcolor="#f9c784"];
  n5 [label="(a, b)", shape=box, fillcolor="#f9c784"];
  n0 -> n4;
  n0 -> n5;
  n0 -> n1;
  n0 -> n3;
  n1 -> n2;
  n3 -> n2;
  n4 -> n2;
  n5 -> n2;
}