digraph GD {
  rankdir=LR;
  node [style=filled];
  edge [fontsize=10, fontcolor="#52514e"];
  n0 [label="(u,u)", shape=ellipse, fillcolor="#cfe3f7"];
  n1 [label="(u',u')", shape=ellipse, fillcolor="#cfe3f7"];
  n2 [label="(v',v')", shape=ellipse, fillcolor="#cfe3f7"];
  n3 [label="(c,c)", shape=ellipse, fillcolor="#cfe3f7"];
  n4 [label="(d,d)", shape=ellipse, fillcolor="#cfe3f7"];
  n5 [label="(v,v)", shape=ellipse, fillcolor="#cfe3f7"];
  n6 [label="(d, c)", shape=box, fillcolor="#f9c784"];
  n7 [label="(c, d)", shape=box, fillcolor="#f9c784"];
  n8 [label="(u', v')", shape=box, fillcolor="#b9e4c9"];
  n9 [label="[u' | v']", shape=diamond, fillcolor="#e3e3e3"];
  n10 [label="(v', u')", shape=box, fillcolor="#b9e4c9"];
  n11 [label="[v' | u']", shape=diamond, fillcolor="#e3e3e3"];
  n12 [label="(v, (d|c)v')", shape=box, fillcolor="#b9e4c9"];
  n13 [label="[v | v']", shape=diamond, fillcolor="#e3e3e3"];
  n14 [label="((d|c)v', v)", shape=box, fillcolor="#b9e4c9"];
  n15 [label="[v' | v]", shape=diamond, fillcolor="#e3e3e3"];
  n0 -> n8;
  n0 -> n10;
  n0 -> n1;
  n0 -> n2;
  n1 -> n14;
  n1 -> n12;
  n1 -> n6;
  n1 -> n7;
  n1 -> n3;
  n1 -> n4;
  n1 -> n5;
  n2 -> n5;
  n3 -> n2;
  n4 -> n2;
  n6 -> n2;
  n7 -> n2;
  n8 -> n9;
  n9 -> n2 [label="h1 → (d|c)v'"];
  n9 -> n13 [label="h1 → v"];
  n10 -> n11;
  n11 -> n2 [label="h2 → (d|c)v'"];
  n11 -> n15 [label="h2 → v"];
  n12 -> n13;
  n13 -> n5 [label="h2 → v"];
  n14 -> n15;
  n15 -> n5 [label="h1 → v"];
}